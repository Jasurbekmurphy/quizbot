# Bu faylni .env deb nusxalang va qiymatlarni to'ldiring.
# Tokenni @BotFather beradi (bu YANGI bot, boshqa botlarning tokeni emas). Uni hech kimga yubormang.
BOT_TOKEN=
# Test yarata oladiganlarning Telegram ID raqamlari, vergul bilan.
# Bo'sh qoldirilsa, har kim o'z testini yarata oladi. Testni yechish hamma uchun ochiq.
ADMIN_IDS=
# Statistikani («📊 Statistika» tugmasi) ko'ra oladiganlar: Telegram ID raqami, vergul bilan.
# O'z ID raqamingizni bilish uchun botga «📊 Statistika» deb yozing.
OWNER_IDS=
DB_PATH=quiz.db
